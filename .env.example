# Copy to .env. Never commit .env. No private keys here: wallet secrets live in the
# isolated wallet service (Phase 7+) and are loaded from an encrypted keystore.

DEXBOT_ENV=development
DEXBOT_LOG_LEVEL=INFO
DEXBOT_LOG_JSON=true

# Trading mode is paper only. Live mode cannot be set from env; it requires an explicit
# runtime activation flow (Phase 9) that re-checks every risk control.
DEXBOT_ENABLED_CHAINS=solana,base,bsc
# arbitrum is activated later, after the first three are tested.

DEXBOT_DATABASE_URL=postgresql+asyncpg://dexbot:dexbot@localhost:5432/dexbot
DEXBOT_REDIS_URL=redis://localhost:6379/0

# --- Market data ---
DEXBOT_DEXSCREENER_BASE_URL=https://api.dexscreener.com
DEXBOT_DEXSCREENER_PAIRS_RPM=200
DEXBOT_DEXSCREENER_PROFILES_RPM=55
DEXBOT_GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
# Keyless GeckoTerminal is ~5 calls/min per IP (dynamic). Raise only with a CoinGecko key.
DEXBOT_GECKOTERMINAL_RPM=5
# Optional CoinGecko key (switches to pro-api onchain endpoints in a later phase)
DEXBOT_COINGECKO_API_KEY=

# --- RPC (Phase 2b+) ---
DEXBOT_SOLANA_RPC_URL=
DEXBOT_SOLANA_WS_URL=
DEXBOT_BASE_RPC_URL=
DEXBOT_BSC_RPC_URL=
DEXBOT_ARBITRUM_RPC_URL=

# --- Execution / security providers (Phase 4+) ---
# GoPlus and RugCheck are called keyless. Leave the GoPlus key empty.
DEXBOT_ZEROX_API_KEY=
DEXBOT_JUPITER_API_KEY=
DEXBOT_GOPLUS_API_KEY=

# --- Paper book and risk (all optional; these are the defaults) ---
# DEXBOT_PAPER_STARTING_BALANCE_USD=1000
# DEXBOT_PAPER_SCAN_INTERVAL_S=90
# DEXBOT_RISK_MAX_POSITION_USD=50
