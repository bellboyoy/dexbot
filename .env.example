# DEXBOT_RISK_TAKE_PROFIT_PCT=0.15
# DEXBOT_RISK_MAX_HOLD_MINUTES=240
# DEXBOT_RISK_COOLDOWN_LOSSES=2
# DEXBOT_RISK_COOLDOWN_SECONDS=900
